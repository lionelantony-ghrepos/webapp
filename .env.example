# InsForge (optional). The app falls back to static stays when these are blank.
# Never commit real keys. Copy to .env.local after `npx @insforge/cli link`.
# URL: InsForge dashboard → Install, or `npx @insforge/cli current` after link.
# Anon key: `npx @insforge/cli secrets get ANON_KEY`
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Do not put OPENAI_API_KEY here. The concierge calls OpenAI from the
# InsForge edge function; store that key as a project secret, never in Next.js.
